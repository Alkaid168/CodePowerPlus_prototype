# 复制成 .env 后按需修改。没有密钥也能用：题目走手工标注，辅导只返回提示词预览。
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 单次模型请求超时（秒）
DEEPSEEK_TIMEOUT=35
# 数据库文件位置，默认 data/codepowerplus.db
# CODEPOWERPLUS_DB_PATH=data/codepowerplus.db

# 可选采集上传；空secret默认禁用。启用时自行生成至少32字符的随机secret，不提交真实值。
CODEPOWERPLUS_COLLECTION_SECRET=
# 独立采集库，不能指向正式学习库。
# CODEPOWERPLUS_COLLECTION_DB=data/collection.db
# 只允许需要上传的扩展Origin，多个用逗号分隔；本地导出不需要配置。
# CODEPOWERPLUS_COLLECTION_ALLOWED_ORIGINS=chrome-extension://your-extension-id
# 四平台合计逻辑用量提醒/硬上限：默认120/150 MiB。
# CODEPOWERPLUS_COLLECTION_WARNING_BYTES=125829120
# CODEPOWERPLUS_COLLECTION_LIMIT_BYTES=157286400
